# ==========================================================
# Firebase Realtime Cloud Configuration (Optional - browser)
# If left empty, the app runs out-of-the-box in Real-time Local Mode.
# Create a free project at console.firebase.google.com
# ==========================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ==========================================================
# App / Server
# ==========================================================
# Public HTTPS URL of the deployed app (used for Telegram Mini App + webhook)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================================
# Admin security (IMPORTANT: change these in production)
# ==========================================================
ADMIN_PIN=7777
# Long random string used to sign the admin session cookie
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
# Optional bearer token for server-to-server admin calls
ADMIN_API_TOKEN=

# ==========================================================
# Telegram Bot (server-side only - keep secret!)
# ==========================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_ID=
# Secret sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header.
# REQUIRED in production: without it, webhook POSTs are rejected.
TELEGRAM_WEBHOOK_SECRET=
# Optional secret required by /api/telegram/poll when called by scripts/telegram_daemon.js
TELEGRAM_POLL_SECRET=
# How many questions to send per quiz run (0 = no limit)
TELEGRAM_MAX_QUESTIONS=0

# ==========================================================
# Local Telegram + scheduler daemon (scripts/telegram_daemon.js)
# ==========================================================
# Base URL the daemon calls (default http://localhost:3000)
APP_URL=http://localhost:3000
BOT_POLL_INTERVAL_MS=1000
BOT_CRON_INTERVAL_MS=60000

# ==========================================================
# Cron protection (Vercel Cron / external scheduler)
# ==========================================================
CRON_SECRET=

# ==========================================================
# Serverless persistent storage (required on Vercel)
# Upstash Redis REST API or Vercel KV (both free tiers available)
# ==========================================================
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash also accepts these names:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
